{
  "workbench.colorTheme": "Bearded Theme Vivid Black",
  "workbench.iconTheme": "symbols",
  "window.zoomLevel": 0.5,
  "workbench.sideBar.location": "right",
  "workbench.editor.showTabs": "single",
  "window.menuBarVisibility": "hidden",
  "window.titleBarStyle": "native",
  "workbench.layoutControl.enabled": false,
  "window.commandCenter": false,
  "symbols.hidesExplorerArrows": true,
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "explorer.decorations.badges": false,
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.indent": 12,
  "breadcrumbs.enabled": false,
  "workbench.tips.enabled": false,
  "workbench.startupEditor": "none",
  "custom-ui-style.font.sansSerif": "SF Pro Text",
  "custom-ui-style.stylesheet": {
    ".notification-toast": "box-shadow: 0 8px 24px #0006 !important; border-radius: 12px !important",
    ".notifications-center": "border-radius: 12px !important",
    ".quick-input-widget": "top: 25vh !important; border-radius: 12px !important; box-shadow: 0 16px 48px #0008 !important",
    ".quick-input-list .scrollbar": "display: none",
    ".monaco-action-bar.quick-input-inline-action-bar": "display: none",
    ".editor-widget.find-widget": "box-shadow: 0 8px 24px #0006; border-radius: 10px",
    ".monaco-hover": "border-radius: 10px !important",
    ".context-view .monaco-menu": "border-radius: 10px !important",
    ".monaco-list-row": "border-radius: 6px",
    ".monaco-workbench .part.editor > .content .editor-group-container > .title.title-border-bottom:after": "display: none",
    ".monaco-scrollable-element > .shadow.top": "display: none",
    ".sidebar .title-label": "padding: 0 !important",
    ".sidebar": "border: none !important",
    ".monaco-workbench .monaco-list:not(.element-focused):focus:before": "outline: none !important",
    ".monaco-list-row.focused": "outline: none !important",
    ".monaco-editor .scroll-decoration": "display: none",
    ".title-actions": "display: none !important",
    ".title.show-file-icons .label-container .monaco-icon-label.file-icon": "justify-content: center; padding: 0 !important",
    ".title .monaco-icon-label:after": "margin-right: 0",
    ".title .monaco-icon-label.file-icon": "margin: 0 60px"
  },
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.fontSize": 15,
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.5,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.selectionClipboard": false,
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorSurroundingLines": 15,
  "editor.minimap.renderCharacters": false,
  "editor.guides.indentation": false,
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": true,
  "git.autofetch": true,
  "chat.disableAIFeatures": true,
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "workbench.activityBar.compact": true,
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://models.dev/model-schema.json": true,
    "https://opencode.ai/config.json": true,
    "https://opencode.ai/tui.json": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://spec.openapis.org/": true,
    "https://www.schemastore.org/": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
}