{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "crust": "#060607",
    "mantle": "#0f0f11",
    "base": "#141417",
    "surface0": "#1c1c20",
    "surface1": "#282727",
    "surface2": "#393836",
    "overlay0": "#545458",
    "overlay1": "#6e6e74",
    "overlay2": "#9e9e9e",
    "text": "#c7c7cc",
    "subtext": "#ababb1",
    "yellow": "#ffb638",
    "blue": "#28a9ff",
    "green": "#42dd76",
    "red": "#d62c2c",
    "teal": "#14e5d4",
    "mauve": "#a95eff",
    "flamingo": "#ff478d"
  },
  "theme": {
    "primary": {
      "dark": "yellow",
      "light": "yellow"
    },
    "secondary": {
      "dark": "blue",
      "light": "blue"
    },
    "accent": {
      "dark": "teal",
      "light": "teal"
    },
    "error": {
      "dark": "red",
      "light": "red"
    },
    "warning": {
      "dark": "yellow",
      "light": "yellow"
    },
    "success": {
      "dark": "green",
      "light": "green"
    },
    "info": {
      "dark": "blue",
      "light": "blue"
    },
    "text": {
      "dark": "text",
      "light": "base"
    },
    "textMuted": {
      "dark": "overlay1",
      "light": "overlay1"
    },
    "background": {
      "dark": "base",
      "light": "text"
    },
    "backgroundPanel": {
      "dark": "surface0",
      "light": "subtext"
    },
    "backgroundElement": {
      "dark": "surface1",
      "light": "overlay2"
    },
    "border": {
      "dark": "surface1",
      "light": "overlay0"
    },
    "borderActive": {
      "dark": "yellow",
      "light": "yellow"
    },
    "borderSubtle": {
      "dark": "surface0",
      "light": "overlay0"
    },
    "diffAdded": {
      "dark": "green",
      "light": "green"
    },
    "diffRemoved": {
      "dark": "red",
      "light": "red"
    },
    "diffContext": {
      "dark": "overlay0",
      "light": "overlay0"
    },
    "diffHunkHeader": {
      "dark": "surface1",
      "light": "surface1"
    },
    "diffHighlightAdded": {
      "dark": "green",
      "light": "green"
    },
    "diffHighlightRemoved": {
      "dark": "red",
      "light": "red"
    },
    "diffAddedBg": {
      "dark": "#1a2e1a",
      "light": "#e6f4e6"
    },
    "diffRemovedBg": {
      "dark": "#2e1a1a",
      "light": "#f4e6e6"
    },
    "diffContextBg": {
      "dark": "surface0",
      "light": "surface0"
    },
    "diffLineNumber": {
      "dark": "overlay0",
      "light": "overlay0"
    },
    "diffAddedLineNumberBg": {
      "dark": "#1a2e1a",
      "light": "#e6f4e6"
    },
    "diffRemovedLineNumberBg": {
      "dark": "#2e1a1a",
      "light": "#f4e6e6"
    },
    "markdownText": {
      "dark": "text",
      "light": "base"
    },
    "markdownHeading": {
      "dark": "yellow",
      "light": "yellow"
    },
    "markdownLink": {
      "dark": "blue",
      "light": "blue"
    },
    "markdownLinkText": {
      "dark": "teal",
      "light": "teal"
    },
    "markdownCode": {
      "dark": "green",
      "light": "green"
    },
    "markdownBlockQuote": {
      "dark": "overlay0",
      "light": "overlay0"
    },
    "markdownEmph": {
      "dark": "mauve",
      "light": "mauve"
    },
    "markdownStrong": {
      "dark": "yellow",
      "light": "yellow"
    },
    "markdownHorizontalRule": {
      "dark": "surface1",
      "light": "surface1"
    },
    "markdownListItem": {
      "dark": "blue",
      "light": "blue"
    },
    "markdownListEnumeration": {
      "dark": "teal",
      "light": "teal"
    },
    "markdownImage": {
      "dark": "blue",
      "light": "blue"
    },
    "markdownImageText": {
      "dark": "teal",
      "light": "teal"
    },
    "markdownCodeBlock": {
      "dark": "text",
      "light": "base"
    },
    "syntaxComment": {
      "dark": "overlay0",
      "light": "overlay0"
    },
    "syntaxKeyword": {
      "dark": "mauve",
      "light": "mauve"
    },
    "syntaxFunction": {
      "dark": "blue",
      "light": "blue"
    },
    "syntaxVariable": {
      "dark": "text",
      "light": "base"
    },
    "syntaxString": {
      "dark": "green",
      "light": "green"
    },
    "syntaxNumber": {
      "dark": "yellow",
      "light": "yellow"
    },
    "syntaxType": {
      "dark": "teal",
      "light": "teal"
    },
    "syntaxOperator": {
      "dark": "flamingo",
      "light": "flamingo"
    },
    "syntaxPunctuation": {
      "dark": "overlay2",
      "light": "overlay2"
    }
  }
}
