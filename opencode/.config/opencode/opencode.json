{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "lsp": true,
  "enabled_providers": [
    "opencode",
    "opencode-go"
  ],
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode/mimo-v2.6-flash-free",
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "plan": {
      "model": "opencode-go/deepseek-v4.1-flash"
    }
  },
  "mcp": {
    "timeout": {
      "startup": 60000,
      "catalog": 60000,
      "execution": 600000
    },
    "servers": {
      "serena": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "serena-agent",
          "serena",
          "start-mcp-server",
          "--project-from-cwd",
          "--context",
          "agent",
          "--open-web-dashboard",
          "False"
        ],
        "disabled": false
      },
      "helium-devtools": {
        "type": "local",
        "command": [
          "/home/pyyupsk/.local/share/helium-devtools-mcp/node_modules/.bin/chrome-devtools-mcp",
          "--autoConnect",
          "--userDataDir",
          "/mnt/c/Users/pthip/AppData/Local/imput/Helium/User Data",
          "--no-usage-statistics",
          "--no-performance-crux"
        ],
        "disabled": false,
        "timeout": {
          "startup": 60000,
          "catalog": 60000
        },
        "environment": {
          "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
        }
      },
      "openseo": {
        "type": "remote",
        "url": "https://app.openseo.so/mcp"
      }
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true
    }
  }
}
