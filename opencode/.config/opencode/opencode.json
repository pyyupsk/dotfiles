{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/dotfiles/claude/.claude/RTK.md",
    "~/dotfiles/claude/.claude/STYLE.md",
    "~/brain/AGENTS.md",
    "~/brain/now.md",
    "~/brain/dates.md"
  ],
  "plugins": [
    "@dietrichgebert/ponytail"
  ],
  "lsp": true,
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "opencode-go",
      "effect": "allow"
    }
  ],
  "model": "opencode-go/deepseek-v4.1-flash",
  "agents": {
    "title": {
      "model": "opencode/mimo-v2.6-flash-free"
    }
  },
  "mcp": {
    "timeout": {
      "startup": 60000,
      "catalog": 60000,
      "execution": 600000
    },
    "servers": {
      "serena": {
        "type": "local",
        "command": [
          "serena",
          "start-mcp-server",
          "--project-from-cwd",
          "--context",
          "agent",
          "--open-web-dashboard",
          "False"
        ],
        "disabled": false
      }
    }
  }
}
