{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "RTK.md",
    "STYLE.md"
  ],
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "lsp": true,
  "enabled_providers": [
    "opencode",
    "opencode-go"
  ],
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode/mimo-v2.6-flash-free",
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "plan": {
      "model": "opencode-go/deepseek-v4.1-flash"
    }
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true
    },
    "headroom": {
      "type": "local",
      "command": [
        "/home/pyyupsk/.local/share/mise/installs/python/3.13/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    }
  },
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "{env:HEADROOM_PROXY_URL}/v1"
      },
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  }
}
