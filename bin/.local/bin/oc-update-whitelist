#!/usr/bin/env python3
"""Update opencode whitelist with models that are free on Zen, per models.dev pricing."""

import json
import subprocess
import sys

MODELS_DEV_URL = "https://models.dev/api.json"
CONFIG_PATH = "/home/pyyupsk/.config/opencode/opencode.json"


def fetch_free_models():
    result = subprocess.run(
        ["curl", "-s", MODELS_DEV_URL], capture_output=True, text=True, timeout=30
    )
    data = json.loads(result.stdout)
    models = data.get("opencode", {}).get("models", {})
    return [
        model_id
        for model_id, model in models.items()
        if model.get("cost", {}).get("input") == 0 and model.get("cost", {}).get("output") == 0
    ]


def update_config(free_models):
    with open(CONFIG_PATH, "r") as f:
        config = json.load(f)

    config.setdefault("provider", {}).setdefault("opencode", {})["whitelist"] = sorted(free_models)

    with open(CONFIG_PATH, "w") as f:
        json.dump(config, f, indent=2)
        f.write("\n")


def main():
    print("Fetching model pricing from models.dev...")
    free = fetch_free_models()

    if not free:
        print("No free models found.")
        sys.exit(1)

    print(f"\nFree models ({len(free)}):")
    for m in sorted(free):
        print(f"  {m}")

    update_config(free)
    print(f"\nUpdated {CONFIG_PATH}")


if __name__ == "__main__":
    main()
