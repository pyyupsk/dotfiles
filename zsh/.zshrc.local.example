# Template for ~/.zshrc.local (machine-private, never commit).
# Copy to ~/.zshrc.local and chmod 600, then fill in real values.
export LYNX_AI_KEY="..."
export ANTHROPIC_BASE_URL="https://YOUR-HOST"
export ANTHROPIC_AUTH_TOKEN="$LYNX_AI_KEY"
export OPENAI_BASE_URL="https://YOUR-HOST/v1"
export OPENAI_API_KEY="$LYNX_AI_KEY"
