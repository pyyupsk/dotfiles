# Template for ~/.zshrc.local (machine-private, never commit).
# Copy to ~/.zshrc.local and chmod 600, then fill in real values.
# The headroom hook manages the TARGET_API_* lines via headroom-ensure-local.
# >>> headroom secrets >>>
export ANTHROPIC_TARGET_API_URL="https://YOUR-HOST"
export OPENAI_TARGET_API_URL="https://YOUR-HOST/v1"
export ANTHROPIC_TARGET_API_HEADERS='{"x-api-key":"...","authorization":"Bearer ..."}'
export OPENAI_TARGET_API_HEADERS='{"authorization":"Bearer ..."}'
