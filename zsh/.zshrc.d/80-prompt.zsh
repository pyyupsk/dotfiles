# 80-prompt.zsh - Powerlevel10k theme (graceful when dir not cloned yet)
# Powerlevel10k theme
[[ -f ~/powerlevel10k/powerlevel10k.zsh-theme ]] && source ~/powerlevel10k/powerlevel10k.zsh-theme

